{{ 'orteva-styles.css' | asset_url | stylesheet_tag }}
{%- assign simg = section.settings.image -%}
<section class="orteva-scope orteva-section" id="shopify-section-{{ section.id }}-s" style="background:#fff">
  <div class="orteva-container">
    <div class="orteva-head">
      <span class="orteva-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="orteva-h2">{{ section.settings.heading }}</h2>
      <p class="orteva-sub">{{ section.settings.subhead }}</p>
    </div>
    <div class="orteva-hero__grid" style="align-items:center">
      <div class="orteva-gallery__main">
        {%- if simg != blank -%}
          <img src="{{ simg | image_url: width: 800 }}" alt="{{ simg.alt | escape }}" width="800" height="800" loading="lazy">
        {%- elsif product.media[1] -%}
          <img src="{{ product.media[1] | image_url: width: 800 }}" alt="{{ product.title | escape }} detail" width="800" height="800" loading="lazy">
        {%- else -%}
          <img src="{{ 'product-2.png' | placeholder_svg_tag }}" alt="" width="800" height="800">
        {%- endif -%}
      </div>
      <div class="orteva-grid orteva-grid--2" style="gap:1.25rem">
        {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <span class="orteva-tile__ico orteva-tile__ico--soft">&#10003;</span>
          <h3 style="font-size:1rem;font-weight:800;margin:0">{{ block.settings.title }}</h3>
          <p style="color:#5b6b80;font-size:.9rem;margin:.3rem 0 0;line-height:1.5">{{ block.settings.body }}</p>
        </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Orteva Solution",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Meet Orteva" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A knee sleeve that actually fits the knee" },
    { "type": "text", "id": "subhead", "label": "Subhead", "default": "Not a generic tube of fabric — a knee-specific design built around how the joint really moves." },
    { "type": "image_picker", "id": "image", "label": "Detail image (defaults to 2nd product image)" }
  ],
  "blocks": [
    { "type": "feat", "name": "Feature", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Graduated compression" },
      { "type": "textarea", "id": "body", "label": "Body", "default": "A medical-grade knit hugs the joint to support tired, achy knees." }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Orteva Solution", "blocks": [
    { "type": "feat", "settings": { "title": "Graduated compression", "body": "A medical-grade nylon/spandex knit hugs the joint to support tired, achy knees through a long day." }},
    { "type": "feat", "settings": { "title": "Anatomical gel ring", "body": "A silicone ring cradles and centers your kneecap — the difference between targeted support and a plain tube." }},
    { "type": "feat", "settings": { "title": "Encourages circulation", "body": "Gentle, even pressure supports healthy blood flow so your knees feel fresher for longer." }},
    { "type": "feat", "settings": { "title": "Helps calm swelling", "body": "Consistent compression can help manage the everyday puffiness that builds up after activity." }},
    { "type": "feat", "settings": { "title": "Breathable all-day comfort", "body": "Moisture-wicking and slim enough to disappear under trousers — wear it morning to night." }},
    { "type": "feat", "settings": { "title": "Dual non-slip cuffs", "body": "Two silicone grip bands keep it exactly where you put it. No rolling, bunching, or sliding down." }}
  ]}]
}
{% endschema %}
